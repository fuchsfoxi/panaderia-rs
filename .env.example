# ==========================================================================
# COPIAR ESTE ARCHIVO A .env Y AJUSTAR LOS DATOS DE LA BASE
#
#   cp .env.example .env
#   php artisan key:generate
#
# .env NO se sube a Git (esta en .gitignore): aca van los datos de la
# maquina de cada uno, no datos reales de la panaderia.
# ==========================================================================

APP_NAME="Panificadora Amazónica"
APP_ENV=local
APP_KEY=
# true solo para desarrollo local. Con false el sistema no muestra pantallas
# de error con informacion interna: hay que ponerlo en false antes de probar
# el sistema con usuarios reales.
APP_DEBUG=true
APP_URL=http://localhost:8000

# Idioma de la interfaz. Los mensajes de validación salen en español; los
# archivos están en lang/es/.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos -------------------------------------------------------
# MariaDB / MySQL. La base se crea a mano una sola vez (ver README).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panaderia-rs
# Usuario de la base. En esta maquina el usuario es 'root'; crear uno propio
# es lo recomendado si la base queda en un servidor compartido.
DB_USERNAME=root
DB_PASSWORD=

# --- Sesión, cache y colas ------------------------------------------------
# Los tres usan la tabla en la base: por eso las migraciones crean las tablas
# 'sessions', 'cache' y 'jobs'. Con SESSION_DRIVER=file no harian falta.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Correo (no se usa todavia: queda en 'log') --------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="panaderia@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# --- Redis (no se usa) ----------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- AWS (no se usa) ------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Vite ----------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
